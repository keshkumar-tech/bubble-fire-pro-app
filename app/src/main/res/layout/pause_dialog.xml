<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="25dp"
    app:cardElevation="15dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAUSE"
                android:textColor="#4E55FF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/btnClosePause"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#888888"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <Button
            android:id="@+id/btnSound"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Sound: ON"
            android:drawableStart="@android:drawable/ic_lock_silent_mode_off"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="10dp"
            app:cornerRadius="15dp" />

        <Button
            android:id="@+id/btnHint"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Hint"
            android:drawableStart="@android:drawable/ic_menu_info_details"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="10dp"
            app:cornerRadius="15dp" />

        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Help"
            android:drawableStart="@android:drawable/ic_menu_help"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="10dp"
            app:cornerRadius="15dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Restart"
            android:drawableStart="@android:drawable/ic_menu_rotate"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="10dp"
            app:cornerRadius="15dp" />

        <Button
            android:id="@+id/btnQuitPause"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Quit"
            android:drawableStart="@android:drawable/ic_lock_power_off"
            android:backgroundTint="#FF4E4E"
            app:cornerRadius="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver: 1.0.0"
            android:textColor="#999999"
            android:textSize="12sp"
            android:layout_marginTop="15dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>